# create_tree_data.py
import pandas as pd
import numpy as np
import joblib

# -------------------------------
# Sample tree metadata
# -------------------------------
# Example columns: species, latitude, longitude, soil_type, temperature, rainfall
data = {
    "species": [
        "Oak", "Maple", "Pine", "Birch", "Cherry",
        "Oak", "Maple", "Pine", "Birch", "Cherry"
    ],
    "latitude": [37.77, 34.05, 40.71, 41.88, 29.76, 36.17, 39.95, 38.90, 35.22, 32.78],
    "longitude": [-122.42, -118.24, -74.00, -87.63, -95.36, -115.14, -75.16, -77.03, -80.84, -96.80],
    "soil_type": ["Loam", "Clay", "Sandy", "Loam", "Clay", "Sandy", "Loam", "Clay", "Sandy", "Loam"],
    "temperature": [22, 25, 18, 20, 28, 23, 24, 19, 21, 27],
    "rainfall": [800, 1200, 600, 700, 1500, 900, 1300, 650, 750, 1400]
}

# Create DataFrame
tree_data = pd.DataFrame(data)

# Save as pickle
tree_data.to_pickle("tree_data.pkl")
print("tree_data.pkl created successfully!")
